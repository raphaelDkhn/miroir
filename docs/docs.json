{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Miroir",
  "theme": "luma",
  "colors": {
    "primary": "#111111",
    "light": "#3F3F46",
    "dark": "#F4F4F5"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FAFAFA",
      "dark": "#09090B"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/raphaelDkhn/miroir"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/raphaelDkhn/miroir"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"],
    "display": "header"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Harbor docs",
          "icon": "anchor",
          "href": "https://docs.harborframework.com"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index", "quick-start", "core-concepts"]
      },
      {
        "group": "Guides",
        "pages": ["environment", "tasks", "validate", "publish", "train"]
      },
      {
        "group": "Reference",
        "pages": ["manifest", "lifecycle", "spec", "evidence"]
      }
    ]
  }
}
