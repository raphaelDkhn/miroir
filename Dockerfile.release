# syntax=docker/dockerfile:1
# Dockerfile's miroir stage, from the static binaries the release workflow builds
# (dist/miroir-amd64, dist/miroir-arm64) instead of a build stage.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS miroir
RUN apk add --no-cache bash
ARG TARGETARCH
COPY dist/miroir-${TARGETARCH} /usr/local/bin/miroir
COPY --chmod=0755 <<'EOF' /tests/test.sh
#!/bin/bash
exec miroir grade
EOF
WORKDIR /tests
# Harbor's keepalive ignores SIGTERM; nothing in this container needs a graceful stop.
STOPSIGNAL SIGKILL
