{
  "title": "Observation",
  "description": "A step's observation: a tool list or a tool call's result. OpenEnv's validator merges reward and done into it before checking.",
  "anyOf": [
    {"$ref": "#/$defs/ListToolsObservation"},
    {"$ref": "#/$defs/CallToolObservation"}
  ],
  "$defs": {
    "Tool": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "input_schema": {"type": "object"}
      },
      "required": ["name", "description", "input_schema"],
      "additionalProperties": false
    },
    "ToolError": {
      "type": "object",
      "properties": {
        "error_type": {"enum": ["execution_error", "invalid_args", "transport_error", "tool_not_found", "timeout"]},
        "message": {"type": "string"}
      },
      "required": ["error_type", "message"],
      "additionalProperties": false
    },
    "ListToolsObservation": {
      "type": "object",
      "properties": {
        "tools": {"type": "array", "items": {"$ref": "#/$defs/Tool"}},
        "done": {"type": "boolean"},
        "reward": {"type": ["number", "null"]},
        "metadata": {"type": "object"}
      },
      "required": ["tools"],
      "additionalProperties": false
    },
    "CallToolObservation": {
      "type": "object",
      "properties": {
        "tool_name": {"type": "string"},
        "result": {},
        "error": {"anyOf": [{"$ref": "#/$defs/ToolError"}, {"type": "null"}]},
        "done": {"type": "boolean"},
        "reward": {"type": ["number", "null"]},
        "metadata": {"type": "object"}
      },
      "required": ["tool_name"],
      "additionalProperties": false
    }
  }
}
