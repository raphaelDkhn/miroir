{
  "title": "ResetObservation",
  "description": "The task the agent starts on.",
  "type": "object",
  "properties": {
    "task_id": {"type": "string"},
    "instruction": {"type": "string"},
    "persona": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"}
      },
      "required": ["name", "description"],
      "additionalProperties": false
    },
    "now": {"type": "string", "format": "date-time"},
    "max_steps": {"type": "integer", "minimum": 1},
    "done": {"type": "boolean"},
    "reward": {"type": ["number", "null"]},
    "metadata": {"type": "object"}
  },
  "required": ["task_id", "instruction", "persona", "now", "max_steps"],
  "additionalProperties": false
}
