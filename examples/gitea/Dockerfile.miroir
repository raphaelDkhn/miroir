# Stock Gitea, pinned, plus Postgres, Python for the seed, tini and miroir; one image per world.
# Build all three with `docker buildx bake gitea`, or one with
#   docker build -f Dockerfile.miroir --build-arg WORLD=orbit -t gitea-env:orbit .
ARG PRODUCT_IMAGE=gitea/gitea:28.3.0@sha256:8967bf9deaf3c5c4adae13519436dc1b20c646ac83fe37ae810c933a1045227d
ARG MIROIR_IMAGE=miroir:dev
FROM ${MIROIR_IMAGE} AS miroir

FROM ${PRODUCT_IMAGE}
RUN apk add --no-cache postgresql17 postgresql17-client python3 tini
COPY --from=miroir /usr/local/bin/miroir /usr/local/bin/miroir
COPY app.ini /etc/gitea/app.ini
COPY seed/worlds.py seed/plants.py seed/seed.py /opt/gitea-env/
COPY miroir.yaml /miroir/miroir.yaml
# The image declares /data a volume, which keeps nothing a build writes: Gitea's state goes to
# /var/lib/gitea instead.
RUN for secret in SECRET_KEY INTERNAL_TOKEN JWT_SECRET LFS_JWT_SECRET; do \
      file=/etc/gitea/$(echo "$secret" | tr A-Z a-z) \
      && gitea generate secret "$secret" > "$file" && chown git:git "$file" && chmod 0400 "$file"; \
    done \
 && install -d -o postgres -g postgres /var/lib/postgresql/data \
 && su postgres -s /bin/sh \
      -c "initdb -D /var/lib/postgresql/data --auth=trust --encoding=UTF8 --locale=C.UTF-8" \
 && install -d -o git -g git /var/lib/gitea
# Last, so every layer above is shared by the three worlds.
ARG WORLD
RUN miroir bake
ENTRYPOINT ["tini", "--"]
CMD ["miroir", "run"]
